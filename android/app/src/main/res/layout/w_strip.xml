<?xml version="1.0" encoding="utf-8"?>
<!-- "Now playing" widget, one row high (4x1): a small cover and the line being sung. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="14dp"
    android:background="@drawable/w_bg">
    <ImageView android:id="@+id/w_cover" android:layout_width="36dp" android:layout_height="36dp"
        android:scaleType="centerCrop" android:src="@drawable/w_art" android:clipToOutline="true" android:background="@drawable/w_art" />
    <TextView android:id="@+id/w_line" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="10dp" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
