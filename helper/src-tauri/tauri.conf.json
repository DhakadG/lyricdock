{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LyricDock Helper",
  "version": "1.5.0",
  "identifier": "dev.lyricdock.helper",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "LyricDock Helper", "url": "index.html", "width": 900, "height": 680, "minWidth": 720, "minHeight": 540,
        "resizable": true, "visible": false, "center": true, "decorations": true, "shadow": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
